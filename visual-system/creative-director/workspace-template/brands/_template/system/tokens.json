{
  "$description": "Brand tokens in the W3C Design Tokens format. The repo copy is the source of truth unless bindings.yaml says otherwise. Every empty value below is a placeholder that cd-system fills from direction.md. An empty value is never used in a draft.",
  "color": {
    "ink": {
      "$type": "color",
      "$value": "",
      "$description": "Main text"
    },
    "paper": {
      "$type": "color",
      "$value": "",
      "$description": "Main background"
    },
    "accent": {
      "$type": "color",
      "$value": "",
      "$description": "The accent side of the contradiction. State here when it may be used"
    },
    "muted": {
      "$type": "color",
      "$value": "",
      "$description": "Secondary text and rules"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": []
    },
    "text": {
      "$type": "fontFamily",
      "$value": []
    }
  },
  "type": {
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "",
        "fontWeight": "",
        "lineHeight": "",
        "letterSpacing": ""
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "",
        "fontWeight": "",
        "lineHeight": "",
        "letterSpacing": ""
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "",
        "fontWeight": "",
        "lineHeight": "",
        "letterSpacing": ""
      }
    }
  },
  "space": {
    "unit": {
      "$type": "dimension",
      "$value": ""
    },
    "margin": {
      "$type": "dimension",
      "$value": "",
      "$description": "Outer margin. State the canvas width it was set for"
    }
  },
  "stroke": {
    "hairline": {
      "$type": "dimension",
      "$value": ""
    },
    "rule": {
      "$type": "dimension",
      "$value": ""
    }
  }
}
